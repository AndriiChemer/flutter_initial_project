  "challenges": [
    {
      "id": "deep_listening",
      "title": {
        "ua": "День глибокого слухання",
        "en": "Deep Listening Day"
      },
      "description": {
        "ua": "Слухайте партнера уважно й без перебивань. Ваше завдання — зрозуміти, що для нього дійсно важливо.",
        "en": "Listen to your partner carefully, without interrupting. The goal is to truly understand what matters to them."
      },
      "days": 1,
      "goal": {
        "ua": "Покращити розуміння та знизити конфлікти через недочутість.",
        "en": "Improve understanding and reduce miscommunication-based conflicts."
